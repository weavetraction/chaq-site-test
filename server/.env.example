# 차큐 API 환경변수 (호스팅 서비스의 환경변수 설정에 입력)
DATABASE_URL=postgres://사용자:비밀번호@호스트:5432/chaq
DATABASE_SSL=true
# 32자 이상 임의 문자열 (로그인 쿠키 서명용) — 예: openssl rand -hex 32
JWT_SECRET=
# 사이트 주소 (상담 문의 허용) — 쉼표로 여러 개
SITE_ORIGINS=https://chaq.kr,https://www.chaq.kr,https://weavetraction.github.io
NODE_ENV=production
PORT=8080
# 사이트 견적 데이터 캐시 시간(초)
PUBLIC_QUOTES_MAX_AGE=60
