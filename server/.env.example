# 차큐 API 환경변수
# AWS(ECS) 에서는 CDK(infra/)가 자동으로 넣습니다 — 비밀값은 Secrets Manager chaq/<env>/app·db 에서 주입
# 로컬·다른 호스팅에서는 이 파일을 참고해 설정

# ---- DB: DATABASE_URL 하나, 또는 DB_HOST·DB_PORT·DB_USER·DB_PASSWORD·DB_NAME
DATABASE_URL=postgres://사용자:비밀번호@호스트:5432/chaq
DATABASE_SSL=true
DB_POOL_MAX=10
# 서버 시작 시 DB 마이그레이션 (여러 대가 동시에 시작해도 1대만 적용)
AUTO_MIGRATE=true

# ---- Redis (서버 2대 이상일 때 요청 제한 공유) — 비우면 서버별 메모리
REDIS_URL=

# ---- 보안
# 32자 이상 임의 문자열 (로그인 쿠키 서명용) — 예: openssl rand -hex 32
JWT_SECRET=
# 사이트 주소 (상담 문의 허용) — 쉼표로 여러 개
SITE_ORIGINS=https://chaq.co.kr,https://www.chaq.co.kr
# 앞단 프록시 수 (CloudFront → ALB = 2, 프록시 1개 = 1)
TRUST_PROXY=1

NODE_ENV=production
APP_ENV=prod
PORT=8080
LOG_LEVEL=info
# 사이트 견적 데이터 캐시 시간(초)
PUBLIC_QUOTES_MAX_AGE=60

# ---- 서버 전환 (비우면 건너뜀) — docs/analytics-events.md
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_API_VERSION=v21.0
META_CONTRACT_EVENT=Purchase
META_TEST_EVENT_CODE=

# ---- 알림·모니터링
# 새 문의 알림 웹훅 (Slack Incoming Webhook 등)
NOTIFY_WEBHOOK_URL=
ADMIN_URL=https://chaq.co.kr/admin/
SENTRY_DSN=
SENTRY_TRACES=0.05
